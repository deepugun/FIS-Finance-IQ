table 'DIM_DATE'

	column 'DATE'
		dataType: dateTime
		summarizeBy: none
		isKey
		formatString: yyyy-mm-dd
		sourceColumn: DATE

	column 'DATE_INTEGER'
		dataType: int64
		summarizeBy: none
		sourceColumn: DATE_INTEGER

	column 'DAY_NUMBER'
		dataType: int64
		summarizeBy: none
		sourceColumn: DAY_NUMBER

	column 'DAY_OF_WEEK'
		dataType: int64
		summarizeBy: none
		sourceColumn: DAY_OF_WEEK

	column 'DAY_OF_WEEK_LONG'
		dataType: string
		summarizeBy: none
		sourceColumn: DAY_OF_WEEK_LONG

	column 'DAY_OF_WEEK_SHORT'
		dataType: string
		summarizeBy: none
		sourceColumn: DAY_OF_WEEK_SHORT

	column 'FIRST_DAY_MONTH'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: FIRST_DAY_MONTH

	column 'FIRST_DAY_QUARTER'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: FIRST_DAY_QUARTER

	column 'LAST_DAY_MONTH'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: LAST_DAY_MONTH

	column 'LAST_DAY_QUARTER'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: LAST_DAY_QUARTER

	column 'MONTH_ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: MONTH_ID

	column 'MONTH_NAME_LONG'
		dataType: string
		summarizeBy: none
		sourceColumn: MONTH_NAME_LONG

	column 'MONTH_NAME_SHORT'
		dataType: string
		summarizeBy: none
		sourceColumn: MONTH_NAME_SHORT

	column 'MONTH_YEAR'
		dataType: string
		summarizeBy: none
		sortByColumn: MONTH_ID
		sourceColumn: MONTH_YEAR

	column 'MONTH_YEAR_INTEGER'
		dataType: int64
		summarizeBy: none
		sourceColumn: MONTH_YEAR_INTEGER

	column 'MONTHNUMBER'
		dataType: int64
		summarizeBy: none
		sourceColumn: MONTHNUMBER

	column 'PY_COMPARE_DATE'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: PY_COMPARE_DATE

	column 'QUARTER'
		dataType: string
		summarizeBy: none
		sourceColumn: QUARTER

	column 'QUARTER_ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: QUARTER_ID

	column 'QUARTER_SEQUENCE'
		dataType: int64
		summarizeBy: none
		sourceColumn: QUARTER_SEQUENCE

	column 'REPORTING_MONTH'
		dataType: string
		summarizeBy: none
		sourceColumn: REPORTING_MONTH

	column 'SOW_MONDAY'
		dataType: dateTime
		summarizeBy: none
		formatString: yyyy-mm-dd
		sourceColumn: SOW_MONDAY

	column 'WEEK_OF_YEAR'
		dataType: int64
		summarizeBy: none
		sourceColumn: WEEK_OF_YEAR

	column 'YEAR'
		dataType: int64
		summarizeBy: none
		sourceColumn: YEAR

	column 'YEAR_MONTH'
		dataType: string
		summarizeBy: none
		sourceColumn: YEAR_MONTH

	column 'YEAR_MONTH_SHORT'
		dataType: string
		summarizeBy: none
		sourceColumn: YEAR_MONTH_SHORT

	column 'YEAR_MONTH_SHORT_V1'
		dataType: string
		summarizeBy: none
		sourceColumn: YEAR_MONTH_SHORT_V1

	column 'YEAR_QUARTER'
		dataType: string
		summarizeBy: none
		sourceColumn: YEAR_QUARTER

	partition 'DIM_DATE' = entity
		mode: directLake
		source
			entityName: dim_date
			expressionSource: DL_FIS_Finance
