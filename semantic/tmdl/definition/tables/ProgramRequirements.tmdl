table ProgramRequirements

	column RequirementId
		dataType: string
		isKey
		sourceColumn: RequirementId

	column ProgramId
		dataType: string
		sourceColumn: ProgramId

	column CountryId
		dataType: string
		sourceColumn: CountryId

	column RequiredBIMonths
		dataType: int64
		summarizeBy: none
		sourceColumn: RequiredBIMonths

	column LocalPolicyId
		dataType: string
		sourceColumn: LocalPolicyId

	column Status
		dataType: string
		sourceColumn: Status

	partition ProgramRequirements = entity
		mode: directLake
		source
			entityName: demo_programrequirements
			expressionSource: DL_CommercialInsurance
