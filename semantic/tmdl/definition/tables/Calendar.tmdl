table Calendar

	column Date
		dataType: dateTime
		isKey
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column MonthName
		dataType: string
		sourceColumn: MonthName

	partition Calendar = entity
		mode: directLake
		source
			entityName: demo_calendar
			expressionSource: DL_CommercialInsurance
