table Coverages

	column CoverageId
		dataType: string
		isKey
		sourceColumn: CoverageId

	column PolicyId
		dataType: string
		sourceColumn: PolicyId

	column CoverageName
		dataType: string
		sourceColumn: CoverageName

	column SublimitUSDCents
		dataType: int64
		sourceColumn: SublimitUSDCents

	column WaitingHours
		dataType: int64
		summarizeBy: none
		sourceColumn: WaitingHours

	column SharesPolicyAggregate
		dataType: boolean
		sourceColumn: SharesPolicyAggregate

	partition Coverages = entity
		mode: directLake
		source
			entityName: demo_coverages
			expressionSource: DL_CommercialInsurance
