table PricingScenarios

	column ScenarioId
		dataType: string
		isKey
		sourceColumn: ScenarioId

	column RenewalId
		dataType: string
		sourceColumn: RenewalId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column ScenarioName
		dataType: string
		sourceColumn: ScenarioName

	column RateChange
		dataType: double
		summarizeBy: none
		sourceColumn: RateChange

	column CATLoad
		dataType: double
		summarizeBy: none
		sourceColumn: CATLoad

	column EngineeringCredit
		dataType: double
		summarizeBy: none
		sourceColumn: EngineeringCredit

	column RetentionUSDCents
		dataType: int64
		sourceColumn: RetentionUSDCents

	column LimitUSDCents
		dataType: int64
		sourceColumn: LimitUSDCents

	column TIVUSDCents
		dataType: int64
		sourceColumn: TIVUSDCents

	column BasePremiumUSDCents
		dataType: int64
		sourceColumn: BasePremiumUSDCents

	column ExpectedNonCATUSDCents
		dataType: int64
		sourceColumn: ExpectedNonCATUSDCents

	column ExpectedCATUSDCents
		dataType: int64
		sourceColumn: ExpectedCATUSDCents

	column Commission
		dataType: double
		summarizeBy: none
		sourceColumn: Commission

	column ExpenseRatio
		dataType: double
		summarizeBy: none
		sourceColumn: ExpenseRatio

	column CapitalUSDCents
		dataType: int64
		sourceColumn: CapitalUSDCents

	column IndicatedUSDCents
		dataType: int64
		sourceColumn: IndicatedUSDCents

	column ExpectedLR
		dataType: double
		summarizeBy: none
		sourceColumn: ExpectedLR

	column ExpectedMargin
		dataType: double
		summarizeBy: none
		sourceColumn: ExpectedMargin

	column RiskAdjustedReturn
		dataType: double
		summarizeBy: none
		sourceColumn: RiskAdjustedReturn

	column Attractiveness
		dataType: double
		summarizeBy: none
		sourceColumn: Attractiveness

	column Status
		dataType: string
		sourceColumn: Status

	column LossFactorBasis
		dataType: string
		sourceColumn: LossFactorBasis

	partition PricingScenarios = entity
		mode: directLake
		source
			entityName: demo_pricingscenarios
			expressionSource: DL_CommercialInsurance
