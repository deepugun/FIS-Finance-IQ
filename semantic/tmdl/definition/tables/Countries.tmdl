table Countries

	column CountryId
		dataType: string
		isKey
		sourceColumn: CountryId

	column CountryName
		dataType: string
		sourceColumn: CountryName

	column Region
		dataType: string
		sourceColumn: Region

	column Currency
		dataType: string
		sourceColumn: Currency

	column FXToUSD
		dataType: double
		summarizeBy: none
		sourceColumn: FXToUSD

	column FXDate
		dataType: dateTime
		sourceColumn: FXDate

	partition Countries = entity
		mode: directLake
		source
			entityName: demo_countries
			expressionSource: DL_CommercialInsurance
