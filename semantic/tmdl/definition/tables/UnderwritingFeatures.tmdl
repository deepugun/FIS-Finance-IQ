table UnderwritingFeatures

	/// Account-grain feature table TIV in USD
	measure 'Feature TIV' = DIVIDE(SUM(UnderwritingFeatures[TIVUSDCents]), 100)
		formatString: \$#,##0.00

	/// Account-grain feature table CAT AAL in USD
	measure 'Feature Modeled CAT Loss' = DIVIDE(SUM(UnderwritingFeatures[AALUSDCents]), 100)
		formatString: \$#,##0.00

	/// Account-grain feature table incurred loss in USD
	measure 'Feature Incurred Loss' = DIVIDE(SUM(UnderwritingFeatures[IncurredUSDCents]), 100)
		formatString: \$#,##0.00

	column AccountId
		dataType: string
		isKey
		sourceColumn: AccountId

	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate

	column TIVUSDCents
		dataType: int64
		sourceColumn: TIVUSDCents

	column PriorTIVUSDCents
		dataType: int64
		sourceColumn: PriorTIVUSDCents

	column AALUSDCents
		dataType: int64
		sourceColumn: AALUSDCents

	column PriorAALUSDCents
		dataType: int64
		sourceColumn: PriorAALUSDCents

	column IncurredUSDCents
		dataType: int64
		sourceColumn: IncurredUSDCents

	column PriorIncurredUSDCents
		dataType: int64
		sourceColumn: PriorIncurredUSDCents

	column TIVGrowth
		dataType: double
		summarizeBy: none
		sourceColumn: TIVGrowth

	column CATGrowth
		dataType: double
		summarizeBy: none
		sourceColumn: CATGrowth

	column ClaimsGrowth
		dataType: double
		summarizeBy: none
		sourceColumn: ClaimsGrowth

	column DaysToRenewal
		dataType: int64
		summarizeBy: none
		sourceColumn: DaysToRenewal

	column OpenCritical
		dataType: int64
		summarizeBy: none
		sourceColumn: OpenCritical

	column CAT
		dataType: double
		summarizeBy: none
		sourceColumn: CAT

	column Claims
		dataType: double
		summarizeBy: none
		sourceColumn: Claims

	column Growth
		dataType: double
		summarizeBy: none
		sourceColumn: Growth

	column Engineering
		dataType: double
		summarizeBy: none
		sourceColumn: Engineering

	column Concentration
		dataType: double
		summarizeBy: none
		sourceColumn: Concentration

	column Missing
		dataType: double
		summarizeBy: none
		sourceColumn: Missing

	column Proximity
		dataType: double
		summarizeBy: none
		sourceColumn: Proximity

	partition UnderwritingFeatures = entity
		mode: directLake
		source
			entityName: demo_underwritingfeatures
			expressionSource: DL_CommercialInsurance
