table Locations

	column LocationId
		dataType: string
		isKey
		sourceColumn: LocationId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column InsuredId
		dataType: string
		sourceColumn: InsuredId

	column LocationName
		dataType: string
		sourceColumn: LocationName

	column CountryId
		dataType: string
		sourceColumn: CountryId

	column Latitude
		dataType: double
		summarizeBy: none
		sourceColumn: Latitude

	column Longitude
		dataType: double
		summarizeBy: none
		sourceColumn: Longitude

	column CATZone
		dataType: string
		sourceColumn: CATZone

	column Occupancy
		dataType: string
		sourceColumn: Occupancy

	column BIIndemnityMonths
		dataType: int64
		summarizeBy: none
		sourceColumn: BIIndemnityMonths

	column TIVUSDCents
		dataType: int64
		sourceColumn: TIVUSDCents

	column PriorTIVUSDCents
		dataType: int64
		sourceColumn: PriorTIVUSDCents

	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate

	partition Locations = entity
		mode: directLake
		source
			entityName: demo_locations
			expressionSource: DL_CommercialInsurance
