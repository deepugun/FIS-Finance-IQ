table Renewals

	column RenewalId
		dataType: string
		isKey
		sourceColumn: RenewalId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column RenewalDate
		dataType: dateTime
		sourceColumn: RenewalDate

	column ReviewStatus
		dataType: string
		sourceColumn: ReviewStatus

	column MissingItems
		dataType: int64
		summarizeBy: none
		sourceColumn: MissingItems

	column RequiredItems
		dataType: int64
		summarizeBy: none
		sourceColumn: RequiredItems

	column ExpiringPolicyId
		dataType: string
		sourceColumn: ExpiringPolicyId

	column TargetRateChange
		dataType: double
		summarizeBy: none
		sourceColumn: TargetRateChange

	partition Renewals = entity
		mode: directLake
		source
			entityName: demo_renewals
			expressionSource: DL_CommercialInsurance
