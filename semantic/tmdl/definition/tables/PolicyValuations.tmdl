table PolicyValuations

	column PolicyValuationId
		dataType: string
		isKey
		sourceColumn: PolicyValuationId

	column PolicyId
		dataType: string
		sourceColumn: PolicyId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate

	column WrittenUSDCents
		dataType: int64
		sourceColumn: WrittenUSDCents

	column EarnedUSDCents
		dataType: int64
		sourceColumn: EarnedUSDCents

	partition PolicyValuations = entity
		mode: directLake
		source
			entityName: demo_policyvaluations
			expressionSource: DL_CommercialInsurance
