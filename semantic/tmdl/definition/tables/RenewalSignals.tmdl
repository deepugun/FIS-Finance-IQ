table RenewalSignals

	column SignalId
		dataType: string
		isKey
		sourceColumn: SignalId

	column RenewalId
		dataType: string
		sourceColumn: RenewalId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column SignalType
		dataType: string
		sourceColumn: SignalType

	column Value
		dataType: double
		summarizeBy: none
		sourceColumn: Value

	column Threshold
		dataType: double
		summarizeBy: none
		sourceColumn: Threshold

	column Materiality
		dataType: string
		sourceColumn: Materiality

	column SourceTable
		dataType: string
		sourceColumn: SourceTable

	column DetectedDate
		dataType: dateTime
		sourceColumn: DetectedDate

	column EvidenceKey
		dataType: string
		sourceColumn: EvidenceKey

	partition RenewalSignals = entity
		mode: directLake
		source
			entityName: demo_renewalsignals
			expressionSource: DL_CommercialInsurance
