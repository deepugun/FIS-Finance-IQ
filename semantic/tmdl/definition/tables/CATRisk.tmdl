table CATRisk

	column CATId
		dataType: string
		isKey
		sourceColumn: CATId

	column LocationId
		dataType: string
		sourceColumn: LocationId

	column AccountId
		dataType: string
		sourceColumn: AccountId

	column PerilId
		dataType: string
		sourceColumn: PerilId

	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate

	column AALUSDCents
		dataType: int64
		sourceColumn: AALUSDCents

	column Score
		dataType: int64
		summarizeBy: none
		sourceColumn: Score

	column Severity
		dataType: string
		sourceColumn: Severity

	column ModelVersion
		dataType: string
		sourceColumn: ModelVersion

	column FinancialBasis
		dataType: string
		sourceColumn: FinancialBasis

	column IsCurrent
		dataType: boolean
		sourceColumn: IsCurrent

	partition CATRisk = entity
		mode: directLake
		source
			entityName: demo_catrisk
			expressionSource: DL_CommercialInsurance
