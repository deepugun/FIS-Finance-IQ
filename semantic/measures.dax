DEFINE
    MEASURE Accounts[As Of Date] = SELECTEDVALUE('Calendar'[Date], DATE(2026,9,14))
    MEASURE Accounts[Written Premium] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(PolicyValuations[WrittenUSDCents]),100), PolicyValuations[SnapshotDate] = snapshot)
    MEASURE Accounts[Earned Premium] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(PolicyValuations[EarnedUSDCents]),100), PolicyValuations[SnapshotDate] = snapshot)
    MEASURE Accounts[Total Insured Value] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(Exposures[ValueUSDCents]),100), Exposures[SnapshotDate] = snapshot)
    MEASURE Accounts[Incurred Loss] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(ClaimValuations[IncurredUSDCents]),100), ClaimValuations[SnapshotDate] = snapshot)
    MEASURE Accounts[Paid Loss] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(ClaimValuations[PaidUSDCents]),100), ClaimValuations[SnapshotDate] = snapshot)
    MEASURE Accounts[Outstanding Loss] = [Incurred Loss] - [Paid Loss]
    MEASURE Accounts[Loss Ratio] = DIVIDE([Incurred Loss],[Earned Premium])
    MEASURE Accounts[Claim Count] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DISTINCTCOUNT(ClaimValuations[ClaimId]), ClaimValuations[SnapshotDate] = snapshot)
    MEASURE Accounts[Claim Frequency] =
        VAR snapshot = [As Of Date]
        VAR policyYears = CALCULATE(SUMX(PolicyValuations, DIVIDE(PolicyValuations[EarnedUSDCents],PolicyValuations[WrittenUSDCents])),PolicyValuations[SnapshotDate] = snapshot)
        RETURN DIVIDE([Claim Count],policyYears)
    MEASURE Accounts[Claim Severity] = DIVIDE([Incurred Loss],[Claim Count])
    MEASURE Accounts[Modeled CAT Loss] =
        VAR snapshot = [As Of Date]
        RETURN CALCULATE(DIVIDE(SUM(CATRisk[AALUSDCents]),100),CATRisk[SnapshotDate] = snapshot)
    MEASURE Accounts[CAT Loss To TIV] = DIVIDE([Modeled CAT Loss],[Total Insured Value])
    MEASURE Accounts[Open Recommendations] = CALCULATE(COUNTROWS(EngineeringRecommendations),EngineeringRecommendations[Status] = "Open")
    MEASURE Accounts[Critical Recommendations] = CALCULATE([Open Recommendations],EngineeringRecommendations[IsCritical] = TRUE())
    MEASURE Accounts[Engineering Completion Rate] = DIVIDE(CALCULATE(COUNTROWS(EngineeringRecommendations),EngineeringRecommendations[Status] = "Closed"),COUNTROWS(EngineeringRecommendations))
    MEASURE Accounts[High Materiality Signals] = CALCULATE(COUNTROWS(RenewalSignals),RenewalSignals[Materiality] = "High")
    MEASURE Accounts[Accounts At Renewal Risk] =
        COUNTROWS(FILTER(VALUES(Accounts[AccountId]),
            CALCULATE(MAX(RiskPulse[Pulse])) >= 80 && CALCULATE(MIN(UnderwritingFeatures[DaysToRenewal])) >= 0 && CALCULATE(MIN(UnderwritingFeatures[DaysToRenewal])) <= 90))
    MEASURE Accounts[Premium At Risk] =
        SUMX(FILTER(VALUES(Accounts[AccountId]), CALCULATE(MAX(RiskPulse[Pulse])) >= 80 && CALCULATE(MIN(UnderwritingFeatures[DaysToRenewal])) >= 0 && CALCULATE(MIN(UnderwritingFeatures[DaysToRenewal])) <= 90),
            VAR expiring = CALCULATETABLE(VALUES(Renewals[ExpiringPolicyId]))
            RETURN CALCULATE(DIVIDE(SUM(Policies[WrittenUSDCents]),100), TREATAS(expiring,Policies[PolicyId])))
    MEASURE Accounts[Renewal Rate Change] = SELECTEDVALUE(PricingScenarios[RateChange])
    MEASURE Accounts[TIV YoY] =
        VAR previous = CALCULATE([Total Insured Value], REMOVEFILTERS('Calendar'), TREATAS({DATE(2025,9,14)},'Calendar'[Date]))
        RETURN DIVIDE([Total Insured Value] - previous,previous)
    MEASURE Accounts[Exposure Growth] = [TIV YoY]
    MEASURE Accounts[Loss Ratio YoY] =
        [Loss Ratio] - CALCULATE([Loss Ratio],REMOVEFILTERS('Calendar'),TREATAS({DATE(2025,9,14)},'Calendar'[Date]))
    MEASURE Accounts[CAT Exposure Change] =
        VAR previous = CALCULATE([Modeled CAT Loss],REMOVEFILTERS('Calendar'),TREATAS({DATE(2025,9,14)},'Calendar'[Date]))
        RETURN DIVIDE([Modeled CAT Loss] - previous,previous)
EVALUATE
    CALCULATETABLE(
        ROW("TIV",[Total Insured Value],"CAT AAL",[Modeled CAT Loss],"Incurred",[Incurred Loss],"Critical",[Critical Recommendations]),
        Accounts[AccountId] = "A001")