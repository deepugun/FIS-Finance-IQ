LatestPulse()
| where RunId == 'rehearsal-001'
| project EvaluationKey, AccountId, Pulse, OpenCritical, DaysToRenewal, Fresh, EventTime, EvidenceRef

DedupedEvents()
| where RunId == 'rehearsal-001'
| sort by AccountId asc, EventTime asc, Sequence asc
| serialize
| extend PreviousAccount = prev(AccountId), PreviousPulse = prev(Pulse)
| where AccountId == PreviousAccount and PreviousPulse < 80.0 and Pulse >= 80.0
| project EventId, AccountId, PreviousPulse, Pulse, EventTime, EvidenceRef

DedupedEvents()
| where EventType in ('LargeClaimCreated', 'ReserveIncreased', 'CATAndReserveUpdated')
| project AccountId, LocationId, EventType, ReserveChangePct, EventTime, EvidenceRef

LatestPulse()
| where OpenCritical > 0 and DaysToRenewal <= 45 and Fresh
| project AccountId, OpenCritical, DaysToRenewal, Pulse, EventTime

DedupedEvents()
| where EventType in ('CATModelUpdated', 'CATAndReserveUpdated', 'WeatherAlert')
| summarize MaxCAT=max(CAT), Events=count() by AccountId, bin(EventTime, 5m)

LatestPulse()
| where RunId == 'rehearsal-001' and Fresh
| summarize Accounts=count(), HighRisk=countif(Pulse >= 80), AveragePulse=avg(Pulse)

LatestPulse()
| where RunId == 'rehearsal-001'
| extend NeedsReview = Fresh and Pulse >= 80 and DaysToRenewal <= 45
| project EvaluationKey, AccountId, NeedsReview, Pulse, Fresh, DaysToRenewal, EventTime, EvidenceRef