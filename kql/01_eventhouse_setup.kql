.create-merge table UnderwritingEvents (EventId:string, AccountId:string, RunId:string, Sequence:long, EventTime:datetime, EventType:string, SourceVersion:string, BusinessAsOf:datetime, CAT:real, Claims:real, Growth:real, Engineering:real, Concentration:real, Missing:real, Proximity:real, Pulse:real, DaysToRenewal:long, OpenCritical:long, ReserveChangePct:real, ExposureChangePct:real, LocationId:string, EvidenceRef:string)

.create-or-alter function with (folder='Underwriting') DedupedEvents() {
    UnderwritingEvents
    | summarize arg_max(EventTime, *) by EventId
    | where EventTime <= now()
    | extend ComputedPulse = round(25.0*CAT + 20.0*Claims + 10.0*Growth + 20.0*Engineering + 10.0*Concentration + 10.0*Missing + 5.0*Proximity, 2)
    | where CAT between (0.0 .. 1.0) and Claims between (0.0 .. 1.0) and Growth between (0.0 .. 1.0)
        and Engineering between (0.0 .. 1.0) and Concentration between (0.0 .. 1.0)
        and Missing between (0.0 .. 1.0) and Proximity between (0.0 .. 1.0)
        and abs(ComputedPulse - Pulse) < 0.01
}

.create-or-alter function with (folder='Underwriting') LatestPulse() {
    DedupedEvents()
    | summarize arg_max(EventTime, *) by AccountId, RunId
    | extend Fresh = EventTime > ago(15m), EvaluationKey = strcat(RunId, ':', AccountId)
}